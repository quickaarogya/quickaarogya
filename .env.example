# -----------------------------------------------------------------------------
# Quick Aarogya - Environment Variables Template
# Copy this file to .env or .env.local and configure your environment values
# -----------------------------------------------------------------------------

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/quick_aarogya?sslmode=disable&connection_limit=1"

# Authentication & Security
AUTH_SECRET_SALT="aarogya_clinical_salt_2026"
NEXTAUTH_SECRET="replace-with-a-random-32-character-secret"

# Push Notifications (Firebase Cloud Messaging / Web Push)
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""

# SMS Gateway (Twilio / Telecom Regulatory Provider)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Transactional Email (Resend / AWS SES)
RESEND_API_KEY=""
EMAIL_FROM="no-reply@aarogya.health"

# Payment & Escrow Settlement (Razorpay / Stripe)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
